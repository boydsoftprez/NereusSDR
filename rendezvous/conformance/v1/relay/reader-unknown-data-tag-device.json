{
  "runs": [
    "app"
  ],
  "steps": [
    {
      "connect": "device"
    },
    {
      "from": "device",
      "role": "behaviour",
      "binary": [
        "80",
        "$token:device:s:a"
      ]
    },
    {
      "to": "device",
      "binary": [
        "81",
        "01",
        "01"
      ]
    },
    {
      "to": "device",
      "binary": [
        "05",
        "$bytes:30:u1"
      ]
    },
    {
      "to": "device",
      "binary": [
        "7f",
        "$bytes:30:u2"
      ]
    },
    {
      "to": "device",
      "binary": [
        "01",
        "$bytes:30:c1"
      ]
    }
  ]
}
