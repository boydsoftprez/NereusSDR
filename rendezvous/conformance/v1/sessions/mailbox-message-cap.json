{
  "runs": [
    "service"
  ],
  "serverSetup": {
    "mailboxMessagesPerSide": 1
  },
  "steps": [
    {
      "connect": "station"
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:stationNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "register",
        "id": "$key:a:id",
        "publicKey": "$key:a:publicKey"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge"
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "prove",
        "signature": "$register:a:challenge:signed"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "registered",
        "id": "$key:a:id"
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "nameplate.claim"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "nameplate",
        "nameplate": 1
      }
    },
    {
      "connect": "client"
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:clientNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "client",
      "role": "behaviour",
      "message": {
        "type": "mailbox.open",
        "nameplate": 1
      }
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "mailbox.opened",
        "nameplate": 1
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "mailbox.opened",
        "nameplate": 1
      }
    },
    {
      "from": "client",
      "role": "behaviour",
      "message": {
        "type": "mailbox",
        "body": "{\"type\":\"pair.start\",\"mode\":\"code\",\"device\":{\"publicKey\":\"conformance\",\"name\":\"Conformance\",\"kind\":\"phone\"}}"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "mailbox",
        "body": "{\"type\":\"pair.start\",\"mode\":\"code\",\"device\":{\"publicKey\":\"conformance\",\"name\":\"Conformance\",\"kind\":\"phone\"}}"
      }
    },
    {
      "from": "client",
      "role": "scripted",
      "message": {
        "type": "mailbox",
        "body": "{\"type\":\"pair.spake\",\"step\":0,\"data\":\"Y29uZm9ybWFuY2UtdGVzdC1ib2R5LW5vdC1hLXJlYWwtc3RlcA\"}"
      }
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "error",
        "code": "tooManyMessages",
        "reason": "Too many pairing messages were sent.",
        "retryAfterMs": 0
      }
    },
    {
      "expectSilent": "station"
    }
  ]
}
