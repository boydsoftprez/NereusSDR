{
  "runs": [
    "service",
    "app"
  ],
  "serverSetup": {},
  "steps": [
    {
      "connect": "station"
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:stationNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "register",
        "id": "$key:a:id",
        "publicKey": "$key:a:publicKey"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge"
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "prove",
        "signature": "$register:a:challenge:signed"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "registered",
        "id": "$key:a:id"
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "nameplate.claim"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "nameplate",
        "nameplate": 1
      }
    },
    {
      "connect": "client"
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:clientNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "client",
      "role": "behaviour",
      "message": {
        "type": "mailbox.open",
        "nameplate": 1
      }
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "mailbox.opened",
        "nameplate": 1
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "mailbox.opened",
        "nameplate": 1
      }
    },
    {
      "from": "station",
      "role": "scripted",
      "message": {
        "type": "nameplate.release"
      }
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "mailbox.closed",
        "code": "released"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "nameplate.released"
      }
    }
  ]
}
