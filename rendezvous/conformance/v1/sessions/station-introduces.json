{
  "runs": [
    "service"
  ],
  "serverSetup": {},
  "steps": [
    {
      "connect": "station"
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:stationNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "register",
        "id": "$key:a:id",
        "publicKey": "$key:a:publicKey"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge"
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "prove",
        "signature": "$register:a:challenge:signed"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "registered",
        "id": "$key:a:id"
      }
    },
    {
      "from": "station",
      "role": "scripted",
      "message": {
        "type": "introduce",
        "id": "$key:a:id",
        "device": "$device:d:id",
        "deviceSignature": "$introduce:d:a:stationNonce:signed",
        "offer": "$sdp:offer:offer"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "error",
        "code": "protocolError",
        "reason": "A message could not be read, so the connection was closed. Updating the app or the Core may help.",
        "retryAfterMs": 0
      }
    },
    {
      "expectClosed": "station",
      "code": 1000
    }
  ]
}
