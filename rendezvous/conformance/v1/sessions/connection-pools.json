{
  "runs": [
    "service"
  ],
  "serverSetup": {
    "connectionsPerAddress": 1,
    "maxConnections": 2
  },
  "steps": [
    {
      "connect": "station",
      "address": "192.0.2.1"
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:stationNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "connect": "client",
      "address": "192.0.2.1"
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "error",
        "code": "tooManyConnections",
        "reason": "Too many connections are open from this network. Try again shortly.",
        "retryAfterMs": 5000
      }
    },
    {
      "expectClosed": "client",
      "code": 1000
    },
    {
      "connect": "client2",
      "address": "198.51.100.7"
    },
    {
      "from": "server",
      "to": "client2",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:client2Nonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "connect": "client3",
      "address": "203.0.113.8"
    },
    {
      "from": "server",
      "to": "client3",
      "message": {
        "type": "error",
        "code": "overloaded",
        "reason": "The remote access service is busy. Try again shortly.",
        "retryAfterMs": 5000
      }
    },
    {
      "expectClosed": "client3",
      "code": 1000
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "register",
        "id": "$key:a:id",
        "publicKey": "$key:a:publicKey"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge"
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "prove",
        "signature": "$register:a:challenge:signed"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "registered",
        "id": "$key:a:id"
      }
    },
    {
      "connect": "client4",
      "address": "192.0.2.1"
    },
    {
      "from": "server",
      "to": "client4",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:client4Nonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "connect": "client5",
      "address": "203.0.113.8"
    },
    {
      "from": "server",
      "to": "client5",
      "message": {
        "type": "error",
        "code": "overloaded",
        "reason": "The remote access service is busy. Try again shortly.",
        "retryAfterMs": 5000
      }
    },
    {
      "expectClosed": "client5",
      "code": 1000
    },
    {
      "from": "client4",
      "role": "behaviour",
      "message": {
        "type": "introduce",
        "id": "$key:a:id",
        "device": "$device:d:id",
        "deviceSignature": "$introduce:d:a:client4Nonce:signed",
        "offer": "$sdp:offer:offer"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "introduction",
        "from": "$b64:16:intro",
        "device": "$device:d:id",
        "deviceSignature": "$introduce:d:a:client4Nonce:signed",
        "offer": "$ref:offer",
        "nonce": "$ref:client4Nonce"
      }
    }
  ]
}
