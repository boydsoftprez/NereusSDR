{
  "runs": [
    "service"
  ],
  "serverSetup": {},
  "pairedDevices": [
    "d"
  ],
  "steps": [
    {
      "connect": "station"
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:stationNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "register",
        "id": "$key:a:id",
        "publicKey": "$key:a:publicKey"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge"
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "prove",
        "signature": "$register:a:challenge:signed"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "registered",
        "id": "$key:a:id"
      }
    },
    {
      "connect": "station2",
      "address": "198.51.100.2"
    },
    {
      "from": "server",
      "to": "station2",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:station2Nonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "station2",
      "role": "behaviour",
      "message": {
        "type": "register",
        "id": "$key:b:id",
        "publicKey": "$key:b:publicKey"
      }
    },
    {
      "from": "server",
      "to": "station2",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge2"
      }
    },
    {
      "from": "station2",
      "role": "behaviour",
      "message": {
        "type": "prove",
        "signature": "$register:b:challenge2:signed"
      }
    },
    {
      "from": "server",
      "to": "station2",
      "message": {
        "type": "registered",
        "id": "$key:b:id"
      }
    },
    {
      "connect": "client"
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:clientNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "client",
      "role": "behaviour",
      "message": {
        "type": "introduce",
        "id": "$key:a:id",
        "device": "$device:d:id",
        "deviceSignature": "$introduce:d:a:clientNonce:signed",
        "offer": "$sdp:offer:offer"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "introduction",
        "from": "$b64:16:intro",
        "device": "$device:d:id",
        "deviceSignature": "$introduce:d:a:clientNonce:signed",
        "offer": "$ref:offer",
        "nonce": "$ref:clientNonce"
      }
    },
    {
      "from": "station2",
      "role": "scripted",
      "message": {
        "type": "answer",
        "to": "$ref:intro",
        "answer": "$sdp:answer:answer",
        "turn": true
      }
    },
    {
      "from": "server",
      "to": "station2",
      "message": {
        "type": "error",
        "code": "unknownIntroduction",
        "reason": "That connection attempt has already ended.",
        "retryAfterMs": 0
      }
    },
    {
      "from": "station2",
      "role": "scripted",
      "message": {
        "type": "candidate",
        "to": "$ref:intro",
        "candidate": "$candidate:s1"
      }
    },
    {
      "from": "server",
      "to": "station2",
      "message": {
        "type": "error",
        "code": "unknownIntroduction",
        "reason": "That connection attempt has already ended.",
        "retryAfterMs": 0
      }
    },
    {
      "expectSilent": "client"
    },
    {
      "expectSilent": "station"
    }
  ]
}
