{
  "runs": [
    "service"
  ],
  "serverSetup": {},
  "steps": [
    {
      "connect": "station"
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:stationNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "register",
        "id": "$key:a:id",
        "publicKey": "$key:a:publicKey"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge"
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "prove",
        "signature": "$register:a:challenge:signed"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "registered",
        "id": "$key:a:id"
      }
    },
    {
      "from": "station",
      "role": "scripted",
      "message": {
        "type": "mailbox",
        "body": "{\"type\":\"pair.start\",\"mode\":\"code\",\"device\":{\"publicKey\":\"conformance\",\"name\":\"Conformance\",\"kind\":\"phone\"}}"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "error",
        "code": "noMailbox",
        "reason": "There is no pairing in progress on this connection.",
        "retryAfterMs": 0
      }
    },
    {
      "connect": "client"
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:clientNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "client",
      "role": "behaviour",
      "message": {
        "type": "mailbox.open",
        "nameplate": 5
      }
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "error",
        "code": "nameplateUnknown",
        "reason": "No Core is showing that pairing code right now. Check the code and try again.",
        "retryAfterMs": 0
      }
    },
    {
      "from": "client",
      "role": "scripted",
      "message": {
        "type": "mailbox",
        "body": "{\"type\":\"pair.start\",\"mode\":\"code\",\"device\":{\"publicKey\":\"conformance\",\"name\":\"Conformance\",\"kind\":\"phone\"}}"
      }
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "error",
        "code": "noMailbox",
        "reason": "There is no pairing in progress on this connection.",
        "retryAfterMs": 0
      }
    }
  ]
}
