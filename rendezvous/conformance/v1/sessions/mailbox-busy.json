{
  "runs": [
    "service"
  ],
  "serverSetup": {},
  "steps": [
    {
      "connect": "station"
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:stationNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "register",
        "id": "$key:a:id",
        "publicKey": "$key:a:publicKey"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge"
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "prove",
        "signature": "$register:a:challenge:signed"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "registered",
        "id": "$key:a:id"
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "nameplate.claim"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "nameplate",
        "nameplate": 1
      }
    },
    {
      "connect": "client"
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:clientNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "client",
      "role": "behaviour",
      "message": {
        "type": "mailbox.open",
        "nameplate": 1
      }
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "mailbox.opened",
        "nameplate": 1
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "mailbox.opened",
        "nameplate": 1
      }
    },
    {
      "connect": "client2",
      "address": "203.0.113.9"
    },
    {
      "from": "server",
      "to": "client2",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:client2Nonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "client2",
      "role": "behaviour",
      "message": {
        "type": "mailbox.open",
        "nameplate": 1
      }
    },
    {
      "from": "server",
      "to": "client2",
      "message": {
        "type": "error",
        "code": "nameplateBusy",
        "reason": "Another device is pairing with this Core right now. Try again shortly.",
        "retryAfterMs": 5000
      }
    },
    {
      "expectSilent": "station"
    }
  ]
}
