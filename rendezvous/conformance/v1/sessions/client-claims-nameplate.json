{
  "runs": [
    "service"
  ],
  "serverSetup": {},
  "steps": [
    {
      "connect": "client"
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:clientNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "client",
      "role": "behaviour",
      "message": {
        "type": "mailbox.open",
        "nameplate": 3
      }
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "error",
        "code": "nameplateUnknown",
        "reason": "No Core is showing that pairing code right now. Check the code and try again.",
        "retryAfterMs": 0
      }
    },
    {
      "from": "client",
      "role": "scripted",
      "message": {
        "type": "nameplate.claim"
      }
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "error",
        "code": "protocolError",
        "reason": "A message could not be read, so the connection was closed. Updating the app or the Core may help.",
        "retryAfterMs": 0
      }
    },
    {
      "expectClosed": "client",
      "code": 1000
    }
  ]
}
