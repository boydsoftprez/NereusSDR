      }
    },
    {
      "from": "server",
      "to": "station3",
      "message": {
        "type": "registered",
        "id": "$key:c:id"
      }
    },
    {
      "from": "station3",
      "role": "behaviour",
      "message": {
        "type": "nameplate.claim"
      }
    },
    {
      "from": "server",
      "to": "station3",
      "message": {
        "type": "nameplate",
        "nameplate": 3
      }
    },
    {
      "from": "station2",
      "role": "behaviour",
      "message": {
        "type": "nameplate.release"
      }
    },
    {
      "from": "server",
      "to": "station2",
      "message": {
        "type": "nameplate.released"
      }
    },
    {
      "disconnect": "station"
    },
    {
      "connect": "station4"
    },
    {
      "from": "server",
      "to": "station4",
      "message": {
        "type": "hello",
        "version": 1,
