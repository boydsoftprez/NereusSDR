    {
      "from": "station2",
      "role": "behaviour",
      "message": {
        "type": "register",
        "id": "$key:b:id",
        "publicKey": "$key:b:publicKey"
      }
    },
    {
      "from": "server",
      "to": "station2",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge2"
      }
    },
    {
      "from": "station2",
      "role": "behaviour",
      "message": {
        "type": "prove",
        "signature": "$register:b:challenge2:signed"
      }
    },
    {
      "from": "server",
      "to": "station2",
      "message": {
        "type": "registered",
        "id": "$key:b:id"
      }
    },
    {
      "from": "station2",
      "role": "behaviour",
      "message": {
        "type": "nameplate.claim"
      }
    },
    {
      "from": "server",
      "to": "station2",
      "message": {
        "type": "nameplate",
        "nameplate": 2
      }
    },
    {
      "connect": "station3"
    },
    {
      "from": "server",
      "to": "station3",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:station3Nonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "station3",
      "role": "behaviour",
      "message": {
        "type": "register",
        "id": "$key:c:id",
        "publicKey": "$key:c:publicKey"
      }
    },
    {
      "from": "server",
      "to": "station3",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge3"
      }
    },
    {
      "from": "station3",
      "role": "behaviour",
      "message": {
        "type": "prove",
