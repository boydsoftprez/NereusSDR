        ]
      }
    },
    {
      "from": "station4",
      "role": "behaviour",
      "message": {
        "type": "register",
        "id": "$key:g:id",
        "publicKey": "$key:g:publicKey"
      }
    },
    {
      "from": "server",
      "to": "station4",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge4"
      }
    },
    {
      "from": "station4",
      "role": "behaviour",
      "message": {
        "type": "prove",
        "signature": "$register:g:challenge4:signed"
      }
    },
    {
      "from": "server",
      "to": "station4",
      "message": {
        "type": "registered",
        "id": "$key:g:id"
      }
    },
    {
      "from": "station4",
      "role": "behaviour",
      "message": {
        "type": "nameplate.claim"
      }
    },
    {
      "from": "server",
      "to": "station4",
      "message": {
        "type": "nameplate",
        "nameplate": 1
      }
    },
    {
      "from": "station2",
      "role": "behaviour",
      "message": {
        "type": "nameplate.claim"
      }
    },
    {
      "from": "server",
