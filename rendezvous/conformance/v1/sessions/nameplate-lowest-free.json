{
  "runs": [
    "service"
  ],
  "serverSetup": {},
  "steps": [
    {
      "connect": "station"
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:stationNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "register",
        "id": "$key:a:id",
        "publicKey": "$key:a:publicKey"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge"
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "prove",
        "signature": "$register:a:challenge:signed"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "registered",
        "id": "$key:a:id"
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "nameplate.claim"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "nameplate",
        "nameplate": 1
      }
    },
    {
      "connect": "station2"
    },
    {
      "from": "server",
      "to": "station2",
      "message": {
        "type": "hello",
