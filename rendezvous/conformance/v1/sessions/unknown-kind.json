{
  "runs": [
    "service"
  ],
  "serverSetup": {},
  "steps": [
    {
      "connect": "client"
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "hello",
        "version": 1,
        "nonce": "$b64:32:clientNonce",
        "stun": [
          "stun:rv4.conformance.invalid:3478",
          "stun:rv6.conformance.invalid:3478"
        ]
      }
    },
    {
      "from": "client",
      "role": "scripted",
      "message": {
        "type": "hello",
        "version": 1
      }
    },
    {
      "from": "server",
      "to": "client",
      "message": {
        "type": "error",
        "code": "protocolError",
        "reason": "A message could not be read, so the connection was closed. Updating the app or the Core may help.",
        "retryAfterMs": 0
      }
    },
    {
      "expectClosed": "client",
      "code": 1000
    }
  ]
}
