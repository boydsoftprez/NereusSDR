{
  "runs": [
    "service"
  ],
  "setup": {},
  "steps": [
    {
      "connect": "station"
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge"
      }
    },
    {
      "from": "station",
      "role": "scripted",
      "message": {
        "type": "hello",
        "v": 1,
        "software": "Example Logger",
        "softwareVersion": "3.1",
        "key": "$b64:32:notIssued"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "error",
        "code": "bad-sign-in",
        "reason": "Roundtable did not accept this station's key or signature.",
        "about": "hello",
        "retryAfterMs": 0
      }
    },
    {
      "expectClosed": "station",
      "code": 4001
    }
  ]
}
