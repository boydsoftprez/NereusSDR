{
  "runs": [
    "service"
  ],
  "setup": {},
  "steps": [
    {
      "connect": "station"
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge"
      }
    },
    {
      "from": "station",
      "role": "behaviour",
      "message": {
        "type": "hello",
        "v": 1,
        "software": "$string:software",
        "softwareVersion": "$string:softwareVersion",
        "spki": "$key:a:spki",
        "sig": "$hello:a:challenge:signed"
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "welcome",
        "station": "$key:a:id",
        "kind": "core",
        "callsign": null,
        "grid": null,
        "time": 1800000000000,
        "limits": {
          "readingsPerSecond": 2,
          "presencePerSecond": 1,
          "messagesPerMinute": 6,
          "messagesPerHour": 60,
          "messageCodePoints": 500,
          "messageLines": 10,
          "namesPerMinute": 10,
          "reportsPerHour": 10,
          "slices": 4,
          "reads": 4
        },
        "mentions": []
      }
    },
    {
      "from": "server",
      "to": "station",
      "message": {
        "type": "rooms",
        "gen": 1,
        "rooms": []
      }
    },
    {
      "advanceMs": 1000
    },
    {
      "connect": "station2"
    },
    {
      "from": "server",
      "to": "station2",
      "message": {
        "type": "challenge",
        "nonce": "$b64:32:challenge2"
      }
    },
    {
      "from": "station2",
      "role": "scripted",
      "message": {
        "type": "hello",
        "v": 1,
        "software": "$string:software",
        "softwareVersion": "$string:softwareVersion",
        "spki": "$key:a:spki",
        "sig": "$hello:a:challenge2:signed"
      }
    },
    {
      "from": "server",
      "to": "station2",
      "message": {
        "type": "welcome",
        "station": "$key:a:id",
        "kind": "core",
        "callsign": null,
        "grid": null,
        "time": 1800000001000,
        "limits": {
          "readingsPerSecond": 2,
          "presencePerSecond": 1,
          "messagesPerMinute": 6,
          "messagesPerHour": 60,
          "messageCodePoints": 500,
          "messageLines": 10,
          "namesPerMinute": 10,
          "reportsPerHour": 10,
          "slices": 4,
          "reads": 4
        },
        "mentions": []
      }
    },
    {
      "from": "server",
      "to": "station2",
      "message": {
        "type": "rooms",
        "gen": 1,
        "rooms": []
      }
    },
    {
      "expectClosed": "station",
      "code": 4003
    }
  ]
}
