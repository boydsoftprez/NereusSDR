+int rtcGatherLocalCandidates(int pc, const char **turnServers, int turnServersCount) {
+	return wrap([&] {
+		auto peerConnection = getPeerConnection(pc);
+		if (turnServersCount < 0 || (turnServersCount > 0 && !turnServers))
+			throw std::invalid_argument("Unexpected null pointer for TURN servers");
+
+		std::vector<IceServer> servers;
+		for (int i = 0; i < turnServersCount; ++i) {
+			if (!turnServers[i])
+				throw std::invalid_argument("Unexpected null pointer for a TURN server");
+			servers.emplace_back(string(turnServers[i]));
+		}
+		peerConnection->gatherLocalCandidates(std::move(servers));
+		return RTC_ERR_SUCCESS;
+	});
+}
+
+int rtcGetRemoteFingerprint(int pc, char *buffer, int size) {
+	return wrap([&] {
+		auto peerConnection = getPeerConnection(pc);
+		CertificateFingerprint fingerprint = peerConnection->remoteFingerprint();
+		if (fingerprint.value.empty())
+			return RTC_ERR_NOT_AVAIL;
+
+		return copyAndReturn(CertificateFingerprint::AlgorithmIdentifier(fingerprint.algorithm) +
+		                         " " + fingerprint.value,
+		                     buffer, size);
+	});
+}
