+static bool agent_close_complete_locked(const juice_agent_t *agent) {
+	for (int i = 0; i < agent->close_releases_count; ++i) {
+		const agent_turn_release_t *release = agent->close_releases + i;
+		if (!release->acknowledged || release->pending_allocate)
+			return false;
+	}
+	return true;
