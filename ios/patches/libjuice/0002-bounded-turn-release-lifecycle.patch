+	// Every callback made by the receive/update path holds this same lock.
+	// Quiesce them before IceTransport can disappear.
+	agent->config.cb_state_changed = NULL;
+	agent->config.cb_candidate = NULL;
+	agent->config.cb_gathering_done = NULL;
+	agent->config.cb_recv = NULL;
+	agent->config.user_ptr = NULL;
+	atomic_store(&agent->selected_entry, NULL);
+	agent->close_started = current_timestamp();
+	agent->close_deadline = agent->close_started + TURN_CLOSE_DEADLINE;
+	agent->close_releases_count = 0;
+	atomic_store(&agent->closing, true);
+
+	if (agent->conn_impl) {
+		for (int i = 0; i < agent->entries_count; ++i) {
+			agent_stun_entry_t *entry = agent->entries + i;
+			if (entry->type != AGENT_STUN_ENTRY_TYPE_RELAY || !entry->turn ||
+			    !*entry->turn->credentials.nonce ||
+			    (entry->relayed.len == 0 && !entry->turn->authenticated_allocate_sent))
