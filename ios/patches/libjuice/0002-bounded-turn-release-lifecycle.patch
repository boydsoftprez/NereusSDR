+// Called with the connection lock held. A retransmission keeps its ID;
+// a nonce change, an early absent acknowledgement, or a late Allocate
+// success starts a fresh Refresh transaction.
+static int agent_close_send(juice_agent_t *agent, agent_turn_release_t *release,
+                            bool new_transaction) {
+	agent_stun_entry_t *entry = release->entry;
+	if (new_transaction)
+		juice_random(release->transaction_id, STUN_TRANSACTION_ID_SIZE);
+	release->acknowledged = false;
+
+	stun_message_t msg;
+	memset(&msg, 0, sizeof(msg));
+	msg.msg_class = STUN_CLASS_REQUEST;
+	msg.msg_method = STUN_METHOD_REFRESH;
+	memcpy(msg.transaction_id, release->transaction_id, STUN_TRANSACTION_ID_SIZE);
+	msg.lifetime = 0;
+	msg.lifetime_set = true;
+	msg.credentials = entry->turn->credentials;
+
+	char buffer[BUFFER_SIZE];
+	int size = stun_write(buffer, sizeof(buffer), &msg, entry->turn->password);
+	if (size <= 0 || agent_direct_send(agent, &entry->record, buffer, size, 0) < 0) {
+		JLOG_WARN("TURN allocation release send failed");
+		return -1;
+	}
+	return 0;
+}
+
+static void agent_close_update(juice_agent_t *agent, timestamp_t *next_timestamp) {
+	timestamp_t now = current_timestamp();
+	*next_timestamp = now + 6000000;
+	if (now >= agent->close_deadline || agent_close_complete_locked(agent))
+		return;
+
+	*next_timestamp = agent->close_deadline;
+	for (int i = 0; i < agent->close_releases_count; ++i) {
+		agent_turn_release_t *release = agent->close_releases + i;
+		if (release->acknowledged && !release->pending_allocate)
+			continue;
+		if (release->attempts >= TURN_CLOSE_ATTEMPTS)
+			continue;
+		if (release->next_send <= now) {
+			bool new_transaction = release->attempts == 0 || release->acknowledged;
+			agent_close_send(agent, release, new_transaction);
+			++release->attempts;
+			if (release->attempts < TURN_CLOSE_ATTEMPTS)
+				release->next_send = agent->close_started +
+				                     turn_close_offsets[release->attempts];
+			else
+				release->next_send = agent->close_deadline;
+		}
+		if (release->attempts < TURN_CLOSE_ATTEMPTS &&
+		    release->next_send < *next_timestamp)
+			*next_timestamp = release->next_send;
+	}
+}
