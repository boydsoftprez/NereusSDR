+// Only authenticated TURN responses associated with a closing record are
+// read here. Ordinary ICE dispatch can rearm Allocate, so it is never used
+// after begin-close.
+static int agent_close_input(juice_agent_t *agent, char *buf, size_t len,
+                             const addr_record_t *src) {
+	if (!is_stun_datagram(buf, len))
+		return 0;
+	stun_message_t msg;
+	if (stun_read(buf, len, &msg) < 0 || !STUN_IS_RESPONSE(msg.msg_class))
+		return 0;
+	if (current_timestamp() >= agent->close_deadline)
+		return 0;
+
+	for (int i = 0; i < agent->close_releases_count; ++i) {
+		agent_turn_release_t *release = agent->close_releases + i;
+		agent_stun_entry_t *entry = release->entry;
+		if (!addr_record_is_equal(src, &entry->record, true))
+			continue;
+		bool late_allocate = release->pending_allocate &&
+		    msg.msg_method == STUN_METHOD_ALLOCATE &&
+		    memcmp(msg.transaction_id, release->allocate_id,
+		           STUN_TRANSACTION_ID_SIZE) == 0;
+		bool release_reply = msg.msg_method == STUN_METHOD_REFRESH &&
+		    memcmp(msg.transaction_id, release->transaction_id,
+		           STUN_TRANSACTION_ID_SIZE) == 0;
+		if (!late_allocate && !release_reply)
+			continue;
+
+		// agent_verify_credentials intentionally accepts most TURN errors
+		// without integrity. Release replies need stricter validation.
+		stun_credentials_t offered = msg.credentials;
+		msg.credentials = entry->turn->credentials;
+		if (!msg.has_integrity ||
+		    !stun_check_integrity(buf, len, &msg, entry->turn->password))
+			return 0;
+
+		if (late_allocate) {
+			if (msg.msg_class == STUN_CLASS_RESP_SUCCESS) {
+				release->pending_allocate = false;
+				release->acknowledged = false;
+				agent_close_send(agent, release, true);
+			}
+			return 0;
+		}
+		if (msg.msg_class == STUN_CLASS_RESP_SUCCESS &&
+		    msg.lifetime_set && msg.lifetime == 0) {
+			release->acknowledged = true;
+			return 0;
+		}
+		if (msg.msg_class != STUN_CLASS_RESP_ERROR)
+			return 0;
+		if (msg.error_code == 437) { // Allocation Mismatch: already absent
+			release->acknowledged = true;
+			return 0;
+		}
+		if (msg.error_code == 438 && release->nonce_challenges == 0 &&
+		    *offered.realm && *offered.nonce) {
+			++release->nonce_challenges;
+			stun_process_credentials(&offered, &entry->turn->credentials);
+			agent_close_send(agent, release, true);
+		}
+		return 0;
+	}
+	return 0;
+}
