{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.nereussdr.radio",
  "Version": "1.0.0.0",
  "Name": "NereusSDR",
  "Description": "Untested. No real host has run this plugin yet. Runs NereusSDR's hot key actions from your keys and dials, through a private connection to the NereusSDR window on this computer.",
  "Author": "J.J. Boyd (KG4VCF)",
  "URL": "https://github.com/boydsoftprez/NereusSDR",
  "Icon": "imgs/plugin-icon",
  "CodePath": "plugin.js",
  "Category": "NereusSDR",
  "CategoryIcon": "imgs/plugin-icon",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20"
  },
