      "UUID": "com.nereussdr.radio.tune.up",
      "Name": "Tune up one step",
      "Category": "Tuning",
      "Icon": "imgs/plugin-icon",
      "Tooltip": "Tune up one step",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "PropertyInspectorPath": "pi/slice.html",
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/plugin-icon"
        }
      ],
      "Encoder": {
        "layout": "$A1",
        "TriggerDescription": {
          "Rotate": "Tune up one step"
