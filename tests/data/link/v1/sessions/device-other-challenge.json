{
    "runs": ["station"],
    "stationSetup": {"radio": "static", "slices": 1, "token": "none", "pairedDevice": true},
    "steps": [
        {"from": "station", "message": {"challenge": "$capture:challenge", "features": {"deviceAuth": 1, "pairing": 1, "sessionHolder": 1}, "identity": {"certBinding": "$string", "publicKey": "$string"}, "major": 1, "majors": [1], "minor": 11, "peer": "nereusd", "settingsSchema": 0, "type": "hello"}},
        {"from": "client", "role": "scripted", "message": {"type": "hello", "major": 1, "minor": 11, "settingsSchema": 0, "peer": "NereusSDR iPhone", "majors": [1], "features": {"deviceAuth": 1}}},
        {"from": "client", "role": "scripted", "message": {"type": "auth.request", "token": "", "device": "$device:otherChallenge"}},
        {"from": "station", "message": {"accepted": false, "code": "deviceProofFailed", "reason": "This device could not prove it is paired with this Core.", "retryable": false, "type": "auth.result"}},
        {"expectClosed": {"retryable": false}}
    ]
}
