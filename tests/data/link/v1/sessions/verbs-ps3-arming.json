        {"from": "station", "message": {"accepted": false, "affected": [], "id": "$ref:invoke40", "reason": "This Core is set to receive only.", "type": "command.result", "values": [{"kind": "utf8", "name": "refusalCode", "ordinal": 0, "value": "stationReceiveOnly"}, {"kind": "utf8", "name": "refusalFix", "ordinal": 0, "value": ""}], "verb": "ps3.twoTone"}},
