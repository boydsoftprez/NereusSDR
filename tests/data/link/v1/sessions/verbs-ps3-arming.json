        {"from": "client", "role": "behaviour", "message": {"type": "command.invoke", "verb": "ps3.single", "id": "$int:invoke27:1:4294967295", "args": []}},
        {"from": "station", "message": {"accepted": true, "affected": [], "id": "$ref:invoke27", "reason": "", "type": "command.result", "values": [{"kind": "utf8", "name": "phase", "ordinal": 0, "value": "accepted"}], "verb": "ps3.single"}},
