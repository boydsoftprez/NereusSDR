{
    "runs": ["station"],
    "stationSetup": {"radio": "static", "slices": 1},
    "steps": [
        {"from": "station", "message": {"challenge": "$string", "features": {"deviceAuth": 1, "pairing": 1, "sessionHolder": 1}, "identity": {"certBinding": "$string", "publicKey": "$string"}, "major": 1, "majors": [1], "minor": 11, "peer": "nereusd", "settingsSchema": 0, "type": "hello"}},
        {"from": "client", "role": "scripted", "message": {"type": "hello", "major": 1, "minor": 11, "settingsSchema": 0, "peer": "NereusSDR iPhone"}},
        {"advanceMs": 30000},
        {"from": "station", "message": {"reason": "This app did not finish connecting to the Core in time.", "retryable": true, "type": "session.end"}},
        {"expectClosed": {"retryable": true}}
    ]
}
