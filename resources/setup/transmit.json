    {
      "id": "transmit.dexpVox",
      "title": "DEXP/VOX",
      "where": "station",
      "coverage": "partial: Enable VOX also depends on a live microphone-to-Core line gate; Anti-VOX source is an informational row, not a control",
      "sections": [
        {
          "title": "VOX / DEXP",
          "controls": [
