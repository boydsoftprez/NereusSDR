{
  "version": 15,
  "category": {
    "id": "transmit",
    "title": "Transmit",
    "where": "station"
  },
  "coverage": "partial: Power step attenuator and Tune controls, Speech Processor, TX Profiles, and VOX enable need exact bindings or composite contracts",
  "pages": [
    {
      "id": "transmit.power",
      "title": "Power",
      "where": "station",
      "coverage": "partial: ATT on TX uses the stepAtt facade; Tune fixed drive has SKU-dependent display conversion; TX TUN Meter has no Core apply binding",
      "sections": [
        {
          "title": "Power",
          "controls": [
            {
              "id": "transmit.power.power",
              "label": "Max Power",
              "tooltip": "RF output power (0\u2013100 W)",
              "kind": "slider",
              "binding": {
                "property": {
                  "object": "transmit",
                  "name": "power"
                }
              },
              "applies": "live",
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 5,
                "transmit": true
              },
              "min": 0,
              "max": 100,
              "step": 1
            },
            {
              "id": "transmit.power.attOnTx",
              "label": "ATT on TX",
              "tooltip": "Enables Attenuator on Mercury during Transmit.",
              "kind": "toggle",
              "binding": {
                "property": {
                  "object": "stepAtt",
                  "name": "attOnTxEnabled"
                }
              },
              "applies": "live",
              "requiresDescriptionVersion": 15,
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 5,
                "transmit": true
              }
            },
            {
              "id": "transmit.power.attOnTxValue",
              "label": "ATT on TX (dB):",
              "tooltip": "ATT on TX value in dB (%1..%2).  Active when the ATT on TX checkbox is enabled.  AutoAtt (PS-A) will adjust this automatically during PureSignal cycles; setting a sane starting value (e.g. 10 dB) before arming PS-A avoids the 31.1 dB initial-overload slam on radios where the coupler+PA delivers calcc FB level > 256 at ATT=0.",
              "kind": "integer",
              "binding": {
                "property": {
                  "object": "stepAtt",
                  "name": "attOnTxValue"
                }
              },
              "applies": "live",
              "requiresDescriptionVersion": 15,
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 5,
                "transmit": true
              },
              "unit": "dB",
              "rangeSource": "attOnTx"
            },
            {
              "id": "transmit.power.forceAttWhenPsOff",
              "label": "Force ATT on Tx to 31 when PS-A is off",
              "tooltip": "Forces ATT on Tx to 31 when PS-A is off. CW will do this anyway",
              "kind": "toggle",
              "binding": {
                "property": {
                  "object": "stepAtt",
                  "name": "forceAttWhenPsOff"
                }
              },
              "applies": "live",
              "requiresDescriptionVersion": 15,
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 5,
                "transmit": true
              }
            }
          ]
        },
        {
          "title": "Tune",
          "controls": [
            {
              "id": "transmit.power.tuneDriveSource",
              "label": "Drive Source:",
              "tooltip": "",
              "kind": "choice",
              "binding": {
                "property": {
                  "object": "transmit",
                  "name": "tuneDrivePowerSource"
                }
              },
              "applies": "live",
              "requiresDescriptionVersion": 15,
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 5,
                "transmit": true
              },
              "choices": [
                "Use Drive Slider",
                "Use Tune Slider",
                "Use Fixed Drive"
              ]
            },
            {
              "id": "transmit.power.fixedTunePower",
              "label": "Fixed Tune Power:",
              "tooltip": "",
              "kind": "integer",
              "binding": {
                "property": {
                  "object": "transmit",
                  "name": "tunePower"
                }
              },
              "applies": "live",
              "requiresDescriptionVersion": 15,
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 5,
                "transmit": true
              },
              "rangeFrom": {
                "catalogueTransmit": "tunePower"
              },
              "enabledWhen": {
                "property": {
                  "object": "transmit",
                  "name": "tuneDrivePowerSource"
                },
                "oneOf": [
                  2
                ]
              }
            }
          ]
        },
        {
          "title": "SWR Protection",
          "controls": [
            {
              "id": "transmit.power.SwrProtectionEnabled",
              "label": "Enable Protection SWR >",
              "tooltip": "Show a visual SWR warning in the spectral area",
              "kind": "toggle",
              "binding": {
                "setting": "SwrProtectionEnabled"
              },
              "applies": "live",
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 5,
                "transmit": true
              },
              "valueEncoding": {
                "true": "True",
                "false": "False"
              }
            },
            {
              "id": "transmit.power.SwrProtectionLimit",
              "label": "SWR Protection Limit",
              "tooltip": "",
              "kind": "decimal",
              "binding": {
                "setting": "SwrProtectionLimit"
              },
              "applies": "live",
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 5,
                "transmit": true
              },
              "min": 1,
              "max": 5,
              "step": 0.1
            },
            {
              "id": "transmit.power.SwrTuneProtectionEnabled",
              "label": "Ignore when Tune Pwr <",
              "tooltip": "Disables SWR Protection during Tune.",
              "kind": "toggle",
              "binding": {
                "setting": "SwrTuneProtectionEnabled"
              },
              "applies": "live",
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 5,
                "transmit": true
              },
              "valueEncoding": {
                "true": "True",
                "false": "False"
              }
            },
            {
              "id": "transmit.power.TunePowerSwrIgnore",
              "label": "Tune Power SWR Ignore",
              "tooltip": "",
              "kind": "integer",
              "binding": {
                "setting": "TunePowerSwrIgnore"
              },
              "applies": "live",
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 5,
                "transmit": true
              },
              "min": 5,
              "max": 50,
              "step": 1
            },
            {
              "id": "transmit.power.WindBackPowerSwr",
              "label": "Reduce Pwr if protected",
              "tooltip": "Winds back the power if high swr protection kicks in",
              "kind": "toggle",
              "binding": {
                "setting": "WindBackPowerSwr"
              },
              "applies": "live",
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 5,
                "transmit": true
              },
              "valueEncoding": {
                "true": "True",
                "false": "False"
              }
            }
          ]
        },
        {
          "title": "External TX Inhibit",
          "controls": [
            {
              "id": "transmit.power.TxInhibitMonitorEnabled",
              "label": "Update with TX Inhibit state",
              "tooltip": "NereusSDR follows the radio's TX inhibit input when it changes.",
              "kind": "toggle",
              "binding": {
                "setting": "TxInhibitMonitorEnabled"
              },
              "applies": "live",
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 5,
                "transmit": true
              },
              "valueEncoding": {
                "true": "True",
                "false": "False"
              }
            },
            {
              "id": "transmit.power.TxInhibitMonitorReversed",
              "label": "Reversed logic",
              "tooltip": "Reverse the input state logic",
              "kind": "toggle",
              "binding": {
                "setting": "TxInhibitMonitorReversed"
              },
              "applies": "live",
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 5,
                "transmit": true
              },
              "valueEncoding": {
                "true": "True",
                "false": "False"
              }
            }
          ]
        },
        {
          "title": "PA Control",
          "controls": [
            {
              "id": "transmit.power.DisableHfPa",
              "label": "Disable HF PA",
              "tooltip": "Disables HF PA.",
              "kind": "toggle",
              "binding": {
                "setting": "DisableHfPa"
              },
              "valueEncoding": {
                "true": "True",
                "false": "False"
              },
              "applies": "live",
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 11,
                "transmit": true
              },
              "requiresDescriptionVersion": 13,
              "default": false
            }
          ]
        }
      ],
      "coverageV15": "partial: the TX TUN Meter choice is not wired to anything on the desktop"
    },
