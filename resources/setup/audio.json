    {
      "id": "audio.txProfile",
      "title": "TX Profile",
      "where": "station",
      "coverage": "partial: active profile choice, Save, and Delete need a live collection and action contract",
      "sections": [
        {
          "title": "TX Profile",
          "controls": [
            {
              "id": "audio.txProfile.activeProfile",
              "label": "Active profile:",
              "tooltip": "Active TX Profile.  Switching prompts to save unsaved changes.",
              "kind": "choice",
              "binding": {
                "command": {
                  "verb": "txProfile.select",
                  "valueProperty": {
                    "object": "transmit",
                    "name": "activeTxProfile"
                  },
                  "arguments": {
                    "name": {
                      "$controlValue": true
                    }
                  }
                }
              },
              "applies": "live",
              "requiresDescriptionVersion": 15,
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 3,
                "transmit": true
              },
              "choicesFrom": {
                "jsonNames": {
                  "object": "transmit",
                  "name": "txProfilesJson"
                }
              },
              "unsavedChanges": {
                "title": "Unsaved Profile Changes",
                "question": "The current profile (\"%1\") has been modified.\nSave before switching?",
                "saveVerb": "txProfile.save",
                "watch": [
                  "micGainDb",
                  "micBoost",
                  "micXlr",
                  "lineIn",
                  "lineInBoost",
                  "micTipRing",
                  "micBias",
                  "micPttDisabled",
                  "voxThresholdDb",
                  "voxHangTimeMs",
                  "antiVoxGainDb",
                  "monitorVolume",
                  "amCarrierLevel",
                  "twoToneFreq1",
                  "twoToneFreq2",
                  "twoToneLevel",
                  "twoTonePower",
                  "twoToneFreq2Delay",
                  "twoToneInvert",
                  "twoTonePulsed",
                  "twoToneDrivePowerSource"
                ]
              }
            },
            {
              "id": "audio.txProfile.save",
              "label": "Save...",
              "tooltip": "Save the current transmit settings under a profile name.",
              "kind": "button",
              "binding": {
                "command": {
                  "verb": "txProfile.save",
                  "arguments": {
                    "name": {
                      "$prompt": true
                    }
                  }
                }
              },
              "applies": "live",
              "requiresDescriptionVersion": 15,
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 3,
                "transmit": true
              },
              "prompt": {
                "title": "Save TX Profile",
                "label": "New profile name:",
                "initial": {
                  "$property": {
                    "object": "transmit",
                    "name": "activeTxProfile"
                  }
                },
                "overwrite": {
                  "title": "Overwrite TX Profile",
                  "question": "A profile named \"%1\" already exists.  Overwrite?",
                  "namesFrom": {
                    "object": "transmit",
                    "name": "txProfilesJson"
                  }
                }
              }
            },
            {
              "id": "audio.txProfile.delete",
              "label": "Delete",
              "tooltip": "Delete the currently-selected profile.",
              "kind": "button",
              "binding": {
                "command": {
                  "verb": "txProfile.delete",
                  "arguments": {
                    "name": {
                      "$property": {
                        "object": "transmit",
                        "name": "activeTxProfile"
                      }
                    }
                  }
                }
              },
              "applies": "live",
              "requiresDescriptionVersion": 15,
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 3,
                "transmit": true
              },
              "confirm": "Delete profile \"%1\"?"
            }
          ]
        },
        {
          "title": "TX Filter",
          "controls": [
            {
              "id": "audio.txProfile.filterLow",
              "label": "Low cutoff",
              "tooltip": "TX bandpass filter lower cutoff (Hz).  0 Hz for voice SSB modes.",
              "kind": "integer",
              "binding": {
                "property": {
                  "object": "transmit",
                  "name": "filterLow"
                }
              },
              "applies": "live",
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 1,
                "transmit": true
              },
              "min": 0,
              "max": 5000,
              "step": 1
            },
            {
              "id": "audio.txProfile.filterHigh",
              "label": "High cutoff",
              "tooltip": "TX bandpass filter upper cutoff (Hz).  2900 Hz for typical SSB voice.",
              "kind": "integer",
              "binding": {
                "property": {
                  "object": "transmit",
                  "name": "filterHigh"
                }
              },
              "applies": "live",
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 1,
                "transmit": true
              },
              "min": 200,
              "max": 10000,
              "step": 1
            },
            {
              "id": "audio.txProfile.amCarrierLevel",
              "label": "AM carrier level",
              "tooltip": "AM / SAM / DSB carrier level (%).  100 % = full carrier.  In AM the TX filter is symmetric: +/- High cutoff around the carrier.",
              "kind": "integer",
              "binding": {
                "property": {
                  "object": "transmit",
                  "name": "amCarrierLevel"
                }
              },
              "applies": "live",
              "gate": {
                "capability": "transmitSettingsVersion",
                "min": 2,
                "transmit": true
              },
              "min": 0,
              "max": 100,
              "step": 1
            }
          ]
        }
      ],
      "coverageV15": ""
    }
  ],
  "coverageV15": "partial: Devices, VAX, TCI and Advanced are each computer's own, and TX Input's microphone source, device, buffer and test are the computer's too"
}
