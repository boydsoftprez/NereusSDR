#!/bin/sh
# linuxdeploy installs this launcher as AppRun at the AppImage root.
# Keep the AppImage runtime alive by exec'ing the daemon in this process.
set -eu
app_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "${1-}" = "--nereus-station" ]; then
    shift
    exec "$app_root/usr/bin/nereusd" "$@"
fi
exec "$app_root/usr/bin/NereusSDR" "$@"
